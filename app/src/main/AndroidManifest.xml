<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml - Android应用的配置文件
    
    这个文件告诉Android系统：
    1. 应用需要什么权限（相机、录音、存储等）
    2. 应用有哪些组件（Activity界面、Service服务）
    3. 应用的基本信息（包名、版本号等）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.screenrecord">

    <!-- 
        权限声明部分 - 这些是应用运行所需的权限
        用户安装应用时会看到这些权限请求
    -->
    
    <!-- 相机权限：用于打开摄像头进行录像 -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- 录音权限：用于录制视频时同时录制声音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- 写入外部存储权限：用于将视频保存到手机相册 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    
    <!-- 读取外部存储权限：用于读取已保存的视频文件 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- 前台服务权限：让应用在后台（熄屏时）继续运行录像 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- 前台服务相机权限：Android 11+需要单独声明前台服务使用相机 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    
    <!-- 前台服务麦克风权限：Android 11+需要单独声明前台服务使用麦克风 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    
    <!-- 唤醒锁权限：防止CPU休眠，保证录像不中断 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- 声明应用使用了相机硬件特性 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenRecord">
        
        <!-- 
            主Activity声明 - 这是用户打开应用时看到的第一个界面
            LAUNCHER表示这个Activity会显示在手机桌面图标列表中
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- 
            录像服务声明 - 这是一个后台服务
            用于在熄屏时保持录像继续进行
        -->
        <service
            android:name=".RecordService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
            
    </application>

</manifest>
