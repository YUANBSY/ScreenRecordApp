<?xml version="1.0" encoding="utf-8"?>
<!--
    colors.xml - 颜色资源文件
    
    集中管理颜色的好处：
    1. 统一应用的颜色风格
    2. 方便修改主题颜色
    3. 避免在代码中硬编码颜色值
-->
<resources>
    <!-- 主色调 - 深蓝色背景 -->
    <color name="colorPrimary">#1A1A2E</color>
    
    <!-- 深色变体 -->
    <color name="colorPrimaryDark">#0F0F1A</color>
    
    <!-- 强调色 - 红色，用于录像按钮 -->
    <color name="colorAccent">#FF6B6B</color>
    
    <!-- 背景色 -->
    <color name="background">#1A1A2E</color>
    
    <!-- 文字颜色 -->
    <color name="textPrimary">#FFFFFF</color>
    <color name="textSecondary">#AAAAAA</color>
    <color name="textHint">#666666</color>
    
    <!-- 录像按钮颜色 -->
    <color name="recordButtonNormal">#FF6B6B</color>
    <color name="recordButtonRecording">#FF4444</color>
    
    <!-- 通知图标颜色 -->
    <color name="notificationIcon">#FF6B6B</color>
</resources>
